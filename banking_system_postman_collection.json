				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseJson = pm.response.json();",
									"if (responseJson && responseJson.data && responseJson.data.accessToken) {",
									"    pm.environment.set(\"accessToken\", responseJson.data.accessToken);",
									"}",
									"if (responseJson && responseJson.data && responseJson.data.refreshToken) {",
									"    pm.environment.set(\"refreshToken\", responseJson.data.refreshToken);",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
